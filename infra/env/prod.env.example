# Copy to <repo>/.env.prod (git-ignored). Contains no secrets. Prod deployment is M5.
COMPOSE_PROJECT_NAME=erp-prod
ERP_ENV=prod
ERP_IMAGE_TAG=prod
ERP_REPO=__REPO__
ERP_DATA_ROOT=__REPO__/data/prod
ERP_SECRETS_DIR=__REPO__/secrets/prod
ERP_UID=__UID__
ERP_GID=__GID__
ERP_SUBNET=172.30.91.0/24
ERP_WEB_IP=172.30.91.10
ERP_HTTP_BIND=127.0.0.1:8090
ERP_HTTPS_BIND=__TAILSCALE_IP__:8443
ERP_TLS_SITES=https://__TAILSCALE_IP__:8443
ERP_TLS_DEFAULT_SNI=__TAILSCALE_IP__
ERP_ALLOWED_ORIGINS=http://localhost:8090,https://__TAILSCALE_IP__:8443
ERP_POSTGRES_IMAGE=postgres:17-alpine
ERP_DB_MEM=576m
ERP_API_MEM=384m
ERP_WORKER_MEM=576m
ERP_WEB_MEM=48m
# SEC EDGAR contact User-Agent: "<Name or organisation> <contact email>" — owner-supplied, never committed (D42)
ERP_SEC_USER_AGENT=
