# Copy to <repo>/.env.dev (git-ignored) via `make env-dev`. Contains no secrets.
COMPOSE_PROJECT_NAME=erp-dev
ERP_ENV=dev
ERP_IMAGE_TAG=dev
ERP_REPO=__REPO__
ERP_DATA_ROOT=__REPO__/data/dev
ERP_SECRETS_DIR=__REPO__/secrets/dev
ERP_UID=__UID__
ERP_GID=__GID__
ERP_SUBNET=172.30.90.0/24
ERP_WEB_IP=172.30.90.10
ERP_HTTP_BIND=127.0.0.1:8091
ERP_HTTPS_BIND=127.0.0.1:8444
ERP_DB_BIND=127.0.0.1:5433
ERP_TLS_SITES=https://localhost:8443, https://127.0.0.1:8443
ERP_TLS_DEFAULT_SNI=127.0.0.1
ERP_ALLOWED_ORIGINS=http://localhost:8091,http://127.0.0.1:8091,https://localhost:8444,https://127.0.0.1:8444,http://localhost:5173
ERP_POSTGRES_IMAGE=postgres:17-alpine
ERP_DB_MEM=576m
ERP_API_MEM=384m
ERP_WORKER_MEM=576m
ERP_WEB_MEM=48m
